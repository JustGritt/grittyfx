{
  "name": "grittyfx",
  "version": "1.0.0",
  "description": "Pixel-art effects as code: recolorable at runtime in Godot, Unity and the browser, with glow, sound and hit timing.",
  "keywords": [
    "pixel-art",
    "vfx",
    "effects",
    "gamedev",
    "sprite-sheet",
    "godot",
    "unity",
    "phaser",
    "palette",
    "aseprite"
  ],
  "homepage": "https://justgritt.github.io/grittyfx/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustGritt/grittyfx.git"
  },
  "bugs": "https://github.com/JustGritt/grittyfx/issues",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./fx/*": {
      "types": "./src/core/effect.d.ts",
      "default": "./src/fx/*.js"
    },
    "./runtime/*": "./runtime/*.js"
  },
  "types": "./src/core/index.d.ts",
  "files": [
    "src",
    "runtime",
    "tools"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "render": "node tools/render.mjs",
    "check": "node tools/check.mjs",
    "serve": "node tools/serve.mjs",
    "catalog": "node tools/catalog.mjs"
  }
}
