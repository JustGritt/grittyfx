; Engine configuration file.
; The grittyfx addon's home: addons/grittyfx, a demo (demo/) and headless checks (tests/).

config_version=5

[application]

config/name="grittyfx"
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/grittyfx/plugin.cfg")

[rendering]

environment/defaults/default_clear_color=Color(0.08, 0.07, 0.1, 1)
